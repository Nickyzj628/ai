{
	"name": "@nickyzj2023/ai",
	"version": "1.3.0",
	"description": "我的“pi”，参考了pi-from-scratch",
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"bin": {
		"ai": "./dist/cli.mjs"
	},
	"scripts": {
		"build": "tsdown",
		"check": "biome check --diagnostic-level=error --write src/",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run check && pnpm run typecheck && pnpm run build"
	},
	"author": "nickyzj2023",
	"license": "ISC",
	"engines": {
		"node": ">=26.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^26.4.1",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@nickyzj2023/utils": "link:../utils"
	}
}
