{
	"compilerOptions": {
		// 构建产物由 tsdown 控制，这里仅用于类型检查（tsc --noEmit）
		"noEmit": true,

		// Environment Settings（Node.js ESM 项目）
		"module": "nodenext",
		"target": "esnext",
		"lib": ["esnext"],
		"types": ["node"],
		"moduleResolution": "nodenext",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",

		// 严格模式，尽早暴露潜在问题
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,

		"skipLibCheck": true
	},
	"include": ["src"]
}
